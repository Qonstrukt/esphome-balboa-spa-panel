# Copy to secrets.yaml in the ESPHome config folder (the Device Builder keeps it out of version history).
wifi_ssid: "your-ssid"
wifi_password: "your-password"
ap_wifi_password: "fallback-hotspot-password"
jacuzzi_api_key: "generate with: openssl rand -base64 32"
# Not secret, but site specific: the entities the panel reads
weather_entity: weather.home
forecast_entity: sensor.spa_forecast_hourly
